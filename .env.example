# Host-side tooling only (tools/, tests/test_ha.py, tests/test_ui.py).
# Copy to .env, which is gitignored. The device's own WiFi and broker
# credentials go in secrets.py, not here.

# Home Assistant long-lived access token (Profile -> Security).
HASS_LLAT=

# Home Assistant base URL. Defaults to http://homeassistant.local:8123.
HA_URL=
