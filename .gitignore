# Credentials live here, never in config.py.
# config.py holds tuning parameters and IS versioned -- thresholds and
# timings are worth tracking. WiFi and broker details are not.
secrets.py

# MicroPython
__pycache__/
*.mpy

# Firmware images and flash dumps (large, and re-downloadable)
*.uf2
*.bin

# Tooling artefacts
.playwright-mcp/
*.png
!docs/*.png
# The app's home-screen icons, rendered by tools/make_icons.py.
!app/static/*.png

# OS
Thumbs.db
.DS_Store
desktop.ini

# Host-side tooling credentials, if any are ever needed.
.env
.env.local
.env*.local

# Generated by tools/ota_publish.py. Anchored to the root: the Home Assistant
# integration's own custom_components/smartfan/manifest.json must be tracked.
/manifest.json

# Generated by tools/build_www.py: the gzipped app, staged for the device's
# flash. Derived entirely from app/build, which is itself ignored, and 172 kB
# of compressed bytes that change on every build would make the history
# unreadable for no gain.
www/

# Written by store.py on the device, and by the tests. Never the repo's.
hist.0
hist.1

# Written by settings.py on the device, and by the tests. Never the repo's.
# OTA will not replace it (ota.py PROTECTED); the device keeps its own.
settings.json

# Plans for work that has not been decided yet. docs/ holds what the project
# IS and what it has consciously deferred; logistics/ holds what it MIGHT
# become -- hardware that is not bought, designs not committed to. Keeping
# them unversioned stops a speculative plan from reading, six months later,
# like a promise the repo made.
logistics/

# KiCad: per-user view state, autosaves, backups and lock files.
*.kicad_prl
*-backups/
fp-info-cache
_autosave-*
~*.lck
