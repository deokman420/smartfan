	(text "120 V AC. The fuse is in one lead. The C8 is not polarized, so either lead can be the hot one. No earth, and 0 V is not bonded to the box."
		(exclude_from_sim no)
		(at 25.4 19.05 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "68eb259a-c427-4f32-b818-6e3711fc002c")
	)
	(text "box wall"
		(exclude_from_sim no)
		(at 31.75 26.162 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9e4e88f6-7fb4-4e87-a476-d34658e4129d")
	)
	(text "J1 and F1 are on the box wall. Their wires land in J5, the screw terminal beside the IRM-10. Follow the marks on the module."
		(exclude_from_sim no)
		(at 25.4 46.482 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "450e4283-102e-45c5-9cfb-d64d9bce00ef")
	)
	(text "12 V switch and the fan"
		(exclude_from_sim no)
		(at 25.4 58.42 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "9e35fdfa-05d4-4ba9-a45e-9b4d46b392d3")
	)
	(rectangle
		(start 22.86 134.62)
		(end 132.08 170.18)
		(stroke
			(width 0.254)
			(type dash)
		)
		(fill
			(type none)
		)
		(uuid "68c110ec-b70e-43f8-a497-fb2a7dc26834")
	)
	(text "at the grille, not on this board"
		(exclude_from_sim no)
		(at 25.4 136.144 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "ec1eba22-58d6-4a1b-9406-3ff41ce4499a")
	)
	(text "The SHT40 breakout (Adafruit 4885) also sits here, on J3 pins 1 to 4. Its pull-ups serve the bus."
		(exclude_from_sim no)
		(at 25.4 163.83 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1cc9462d-6c7a-4ddc-aa41-91aa510035c4")
	)
	(text "board side of the grille cables"
		(exclude_from_sim no)
		(at 139.7 134.62 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "2d406edc-aff9-42e6-9ac6-d037b5d1b0e8")
	)
	(text "GP17 high turns the fan on. R2 holds the base low while GP17 floats at boot. The IRF9540 tab is the drain: insulate it from the box."
		(exclude_from_sim no)
		(at 25.4 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1232efb7-6f4d-41e5-aec7-78048373bc99")
	)
	(text "J2 is a keyed 4-pin fan header. NF-F12: 1 black = 0 V, 2 yellow = switched +12 V, 3 green = tach, 4 blue = +5 V (before the diode, never 12 V)."
		(exclude_from_sim no)
		(at 25.4 208.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4334e01d-4161-44cd-b381-caf88df0be82")
	)
	(text "J3, grille sensors: 1 GND, 2 3V3, 3 SDA / GP0, 4 SCL / GP1, 5 LDR, 6 3V3 for the LDR. R6 stays on the board."
		(exclude_from_sim no)
		(at 25.4 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "52032e08-f434-4be4-a284-1f7d265cb197")
	)
	(text "J4, button and LEDs: 1 GND, 2 button, 3 green anode, 4 green cathode, 5 red anode, 6 red cathode. R7, R8 and R9 sit between J4 and the Pico."
		(exclude_from_sim no)
		(at 25.4 218.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7e39f3ad-3ee2-415e-9bc3-126ef41963bc")
	)
	(text "Labels with the same name are one net. VBUS, pin 40, gets no wire. GP22 is free. The DHT22 and the SGP41 are not on this board."
		(exclude_from_sim no)
		(at 25.4 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "33d315e1-3926-4750-883c-19133ea40bfb")
	)
